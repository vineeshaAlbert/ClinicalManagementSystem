@{
    ViewBag.Title = "Receptionist Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>Welcome, @ViewBag.Name!</h2>
        <p class="lead text-muted">Receptionist Dashboard</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <a asp-action="ManagePatients" class="text-decoration-none">
                <div class="card text-white bg-primary shadow h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-person-plus display-6"></i>
                        <h5 class="card-title mt-2">Manage Patients</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="ScheduleAppointment" class="text-decoration-none">
                <div class="card text-white bg-success shadow h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar2-check display-6"></i>
                        <h5 class="card-title mt-2">Schedule Appointment</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="ViewAppointments" class="text-decoration-none">
                <div class="card text-white bg-warning shadow h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-list-ul display-6"></i>
                        <h5 class="card-title mt-2">View Appointments</h5>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="GenerateBill" class="text-decoration-none">
                <div class="card text-white bg-danger shadow h-100">
                    <div class="card-body text-center">
                        <i class="bi bi-cash-coin display-6"></i>
                        <h5 class="card-title mt-2">Generate Bill</h5>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="mt-5 text-center">
        <a asp-action="Logout" class="btn btn-outline-dark">Logout</a>
    </div>
</div>
