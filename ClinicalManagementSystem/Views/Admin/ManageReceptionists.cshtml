@model IEnumerable<ClinicalManagementSystem.Models.Receptionist>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Manage Receptionists</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap + Fonts + Custom CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(to bottom right, #f3e5f5, #ce93d8, #ab47bc);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
        }

        .logo {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .logo img {
            max-width: 200px;
            height: auto;
        }

        h2.text-center {
            color: #4a148c;
            font-weight: 700;
            margin-top: 1px;
            margin-bottom: 30px;
        }

        .table {
            background-color: transparent;
        }

        .table th,
        .table td {
            border: none !important;
            background-color: transparent !important;
            color: #3c0060;
            text-align: center;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .btn {
            font-weight: 600;
        }

        .btn-purple {
            background-color: #6a1b9a;
            color: white;
        }

        .btn-purple:hover {
            background-color: #4a148c;
            color: white;
        }

        .modal-header-purple {
            background-color: #6a1b9a;
            color: white;
        }

        .btn-close-white {
            filter: invert(1);
        }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 24px;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #f8d7da;
            transition: .4s;
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        .toggle-switch input:checked + .slider {
            background-color: #6a1b9a;
        }

        .toggle-switch input:checked + .slider:before {
            transform: translateX(24px);
        }
    </style>
</head>
<body>

<div class="logo">
    <img src="~/img/Logo.png" alt="CMS Logo" />
</div>

<div class="container">
    <h2 class="text-center">Manage Receptionists</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    <div class="d-flex justify-content-between mb-3">
        <a class="btn btn-purple" href="@Url.Action("Index", "Admin")">← Back to Dashboard</a>
        <button class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#addReceptionistModal">+ Add Receptionist</button>
    </div>

    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Emp ID</th>
                <th>Name</th>
                <th>Contact</th>
                <th>Username</th>
                <th>Password</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.ReferenceId</td>
                    <td>@r.Name</td>
                    <td>@r.Phone</td>
                    <td>@r.Username</td>
                    <td>@r.Password</td>
                    <td>
                        <label class="toggle-switch">
                            <input type="checkbox" class="toggle-active" data-user-id="@r.ReceptionistId" @(r.IsActive ? "checked" : "") />
                            <span class="slider"></span>
                        </label>
                    </td>
                    <td>
                        <a href="#" class="btn btn-purple btn-sm" data-bs-toggle="modal" data-bs-target="#editReceptionistModal-@r.ReceptionistId">Edit</a>
                        <a href="@Url.Action("DeleteReceptionist", "Admin", new { id = r.ReceptionistId })"
                           class="btn btn-purple btn-sm"
                           onclick="return confirm('Are you sure you want to delete this receptionist?');">Delete</a>
                    </td>
                </tr>

                <!-- Edit Modal -->
                <div class="modal fade" id="editReceptionistModal-@r.ReceptionistId" tabindex="-1" aria-labelledby="editReceptionistLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="EditReceptionist" method="post">
                                <input type="hidden" name="ReceptionistId" value="@r.ReceptionistId" />
                                <div class="modal-header modal-header-purple">
                                    <h5 class="modal-title">Edit Receptionist</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label">Name</label>
                                        <input class="form-control" name="Name" value="@r.Name" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Contact</label>
                                        <input class="form-control" name="Phone" value="@r.Phone" required />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button class="btn btn-purple" type="submit">Save Changes</button>
                                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
</div>

<!-- Add Receptionist Modal -->
<div class="modal fade" id="addReceptionistModal" tabindex="-1" aria-labelledby="addReceptionistModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddReceptionist" method="post">
                <div class="modal-header modal-header-purple">
                    <h5 class="modal-title">Add Receptionist</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact</label>
                        <input class="form-control" name="Phone" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-purple" type="submit">Add</button>
                    <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
    $(document).ready(function () {
        $('.toggle-active').change(function () {
            var userId = $(this).data('user-id');
            var isActive = $(this).is(':checked');

            $.post('/Admin/ToggleStatus', { userId: userId, isActive: isActive })
                .done(() => console.log("Status updated"))
                .fail(() => alert("Failed to update status."));
        });
    });
</script>

</body>
</html>
